{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run type-check && next build",
    "build:check": "tsc --noEmit --listFiles | head -5 && tsc --noEmit",
    "build:fast": "next build",
    "type-check": "tsc --noEmit --pretty",
    "type-check:watch": "tsc --noEmit --pretty --watch",
    "type-check:all": "tsc --noEmit --pretty || true",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:all": "pnpm run lint && pnpm run lint:prettier && pnpm run lint:commitlint",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:commitlint": "commitlint --from=HEAD~1",
    "lint:spellcheck": "cspell \"**/*.{ts,tsx,js,jsx,md,mdx,json}\"",
    "format": "pnpm run lint:prettier:fix && pnpm run lint:fix",
    "verify": "pnpm run build && pnpm run lint && pnpm run format",
    "verify:fast": "pnpm run build:fast && pnpm run lint && pnpm run format",
    "db:types": "pnpm dlx supabase gen types typescript --linked --schema public > ./lib/db.types.ts",
    "db:pull:schemas": "pnpm dlx supabase db pull --schema auth,public"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^6.1.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "^2.50.0",
    "@types/uuid": "^10.0.0",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.18.1",
    "lucide-react": "^0.468.0",
    "next": "latest",
    "prettier": "^3.5.3",
    "react": "19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "9.7.0",
    "react-dom": "19.0.0",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^6.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.5",
    "stripe": "^18.2.1",
    "twilio": "^5.7.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.29.0",
    "@next/eslint-plugin-next": "^15.3.4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "autoprefixer": "^10.4.21",
    "cspell": "^9.1.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.3",
    "eslint-plugin-testing-library": "^7.5.3",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.2.0",
    "postcss": "8.4.49",
    "supabase": "^2.26.9",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.34.1",
    "vite-plugin-eslint": "^1.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "supabase"
    ],
    "overrides": {
      "axios@>=1.0.0 <1.8.2": ">=1.8.2",
      "next@>=15.0.0 <15.2.3": ">=15.2.3",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "@supabase/auth-js@<2.69.1": ">=2.69.1",
      "next@>=13.0 <15.2.2": ">=15.2.2"
    }
  }
}
