{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run type-check && next build",
    "build:check": "tsc --noEmit --listFiles | head -5 && tsc --noEmit",
    "build:fast": "next build",
    "type-check": "tsc --noEmit --pretty --project tsconfig.build.json",
    "type-check:watch": "tsc --noEmit --pretty --watch --project tsconfig.build.json",
    "type-check:all": "tsc --noEmit --pretty --project tsconfig.build.json || true",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:all": "pnpm run lint && pnpm run lint:prettier && pnpm run lint:commitlint && pnpm run lint:unused",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:commitlint": "commitlint --from=HEAD~1",
    "lint:spellcheck": "cspell \"**/*.{ts,tsx,js,jsx,md,mdx,json}\"",
    "lint:security": "echo 'Security check skipped - install semgrep manually if needed'",
    "lint:dependency": "echo 'Dependency check skipped - install depcheck manually if needed'",
    "lint:unused": "next-unused --config next-unused.config.js",
    "lint:unused-imports": "pnpm dlx unimported",
    "lint:unused-exports": "ts-unused-exports tsconfig.json",
    "format": "pnpm run lint:prettier:fix && pnpm run lint:fix",
    "verify": "pnpm run build && pnpm run lint && pnpm run format",
    "verify:fast": "pnpm run build:fast && pnpm run lint && pnpm run format",
    "db:types": "pnpm dlx supabase gen types typescript --linked --schema public > ./lib/db.types.ts",
    "db:pull:schemas": "pnpm dlx supabase db pull --schema auth,public",
    "types:copy": "./scripts/copy-types.sh",
    "types:copy-stripe": "./scripts/copy-types.sh --stripe-only",
    "types:copy-node": "./scripts/copy-types.sh --node-only",
    "types:compile": "cd lib/stripe-types && tsc --project tsconfig.json && cd ../node-types && tsc --project tsconfig.json 2>/dev/null || true",
    "types:compile-stripe": "cd lib/stripe-types && tsc --project tsconfig.json",
    "types:compile-node": "cd lib/node-types && tsc --project tsconfig.json 2>/dev/null || true",
    "types:validate": "cd lib/stripe-types && tsc --noEmit validate.ts && cd ../node-types && tsc --noEmit validate.ts 2>/dev/null || true",
    "types:generate-all": "pnpm run types:copy && pnpm run types:compile && pnpm run types:validate",
    "ts-to-zod": "pnpm dlx ts-to-zod ./zod_schemas/stripe.ts ./lib/zod-schemas/stripe.ts",
    "ts-to-zod:watch": "pnpm dlx ts-to-zod ./zod_schemas/stripe.ts ./lib/zod-schemas/stripe.ts --watch",
    "ts-to-zod:generate": "pnpm run ts-to-zod && pnpm run db:types",
    "ts-to-zod:generate:watch": "pnpm run ts-to-zod:watch && pnpm run db:types"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^6.1.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "^2.49.1",
    "@types/uuid": "^10.0.0",
    "chart.js": "^4.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.468.0",
    "next": "latest",
    "prettier": "^3.3.3",
    "react": "19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "8.10.1",
    "react-dom": "19.0.0",
    "react-dropzone": "^14.3.8",
    "react-error-boundary": "^6.0.0",
    "sonner": "^2.0.1",
    "stripe": "^18.0.0",
    "twilio": "^5.4.5",
    "uuid": "^11.1.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.26.0",
    "@microsoft/api-extractor": "^7.52.8",
    "@next/eslint-plugin-next": "^15.3.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.34.0",
    "autoprefixer": "^10.4.21",
    "cspell": "^9.0.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "eslint-plugin-testing-library": "^7.1.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.1.0",
    "next-unused": "^0.0.6",
    "postcss": "8.4.49",
    "supabase": "^2.23.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-to-zod": "^3.15.0",
    "ts-unused-exports": "^11.0.1",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.32.0",
    "unimported": "^1.31.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "axios@>=1.0.0 <1.8.2": ">=1.8.2",
      "next@>=15.0.0 <15.2.3": ">=15.2.3",
      "@babel/runtime@<7.26.10": ">=7.26.10",
      "@supabase/auth-js@<2.69.1": ">=2.69.1",
      "next@>=13.0 <15.2.2": ">=15.2.2"
    }
  }
}
